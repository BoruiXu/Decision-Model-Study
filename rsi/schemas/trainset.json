{
  "type": "object",
  "required": ["label_method", "parent_trainset", "changes", "quality"],
  "properties": {
    "kind": {"type": "string", "enum": ["trainset"]},
    "label_method": {"type": "string"},
    "parent_trainset": {"type": ["string", "null"]},
    "changes": {"type": "string"},
    "quality": {
      "type": "object",
      "required": ["passed", "checks"],
      "additionalProperties": false,
      "properties": {
        "passed": {"type": "boolean"},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value", "threshold", "passed"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "value": {"type": ["number", "string", "boolean", "null"]},
              "threshold": {"type": ["number", "string", "boolean", "null"]},
              "passed": {"type": "boolean"}
            }
          }
        }
      }
    },
    "prompt_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "instructions", "criteria", "rename", "tables"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "instructions": {"type": ["string", "null"], "minLength": 1},
          "criteria": {"type": ["object", "array", "null"]},
          "rename": {"type": ["object", "null"], "additionalProperties": {"type": "string", "minLength": 1}},
          "tables": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
