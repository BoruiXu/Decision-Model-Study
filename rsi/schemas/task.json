{
  "type": "object",
  "required": ["kind", "task_id", "version", "decision", "input", "data", "metrics",
               "promotion_rule", "stop", "budget", "resources", "eval_use_limit", "approvals"],
  "additionalProperties": false,
  "properties": {
    "kind": {"type": "string", "enum": ["task"]},
    "task_id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]*"},
    "version": {"type": "integer", "minimum": 1},
    "decision": {
      "type": "object",
      "required": ["type", "instructions", "labels", "label_meanings"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["binary", "choice", "score"]},
        "instructions": {"type": "string", "minLength": 1},
        "labels": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "label_meanings": {"type": "object", "additionalProperties": {"type": "string"}},
        "positive": {"type": "string"}
      }
    },
    "input": {
      "type": "object",
      "required": ["format", "description"],
      "additionalProperties": false,
      "properties": {
        "format": {"type": "string", "enum": ["messages", "fields", "object"]},
        "description": {"type": "string"},
        "fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "data": {
      "type": "object",
      "required": ["sources", "label_sources"],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": ["string", "object"],
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "about": {"type": "string"}
            }
          }
        },
        "label_sources": {"type": "array",
                          "items": {"type": "string", "enum": ["rule", "model_judge", "human", "outcome"]}},
        "rows": {
          "type": "object",
          "required": ["about"],
          "additionalProperties": false,
          "properties": {
            "about": {"type": "string", "minLength": 1},
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rows": {"type": "integer", "minimum": 0},
                "label_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
              }
            }
          }
        },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "by": {"type": "string", "enum": ["time", "group", "random"]},
            "key": {"type": "string", "pattern": "[^.]+(\\.[^.]+)*"},
            "ranges": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "trainset": {"type": "array", "items": {"type": "number"}},
                "valset": {"type": "array", "items": {"type": "number"}},
                "evalset": {"type": "array", "items": {"type": "number"}},
                "testset": {"type": "array", "items": {"type": "number"}}
              }
            },
            "fractions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "trainset": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                "valset": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                "evalset": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                "testset": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
              }
            },
            "sizes": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "trainset": {"type": ["integer", "null"], "minimum": 1},
                "valset": {"type": ["integer", "null"], "minimum": 1},
                "evalset": {"type": ["integer", "null"], "minimum": 1},
                "testset": {"type": ["integer", "null"], "minimum": 1}
              }
            },
            "stratify": {"type": "boolean"},
            "unit": {"type": "string", "enum": ["cluster", "state_id"]},
            "seed": {"type": "integer"}
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["primary", "higher_is_better", "others", "baselines"],
      "additionalProperties": false,
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "higher_is_better": {"type": "boolean"},
        "others": {"type": "array", "items": {"type": "string"}},
        "baselines": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "ci": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resamples": {"type": "integer", "minimum": 100},
            "seed": {"type": "integer"},
            "level": {"type": "number"}
          }
        }
      }
    },
    "promotion_rule": {
      "type": "object",
      "required": ["min_delta", "ci_lower_min", "guards"],
      "additionalProperties": false,
      "properties": {
        "min_delta": {"type": "number"},
        "ci_lower_min": {"type": ["number", "null"]},
        "guards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "higher_is_better", "max_regression"],
            "additionalProperties": false,
            "properties": {
              "metric": {"type": "string"},
              "higher_is_better": {"type": "boolean"},
              "max_regression": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "stop": {
      "type": "object",
      "required": ["target", "max_rounds"],
      "additionalProperties": false,
      "properties": {
        "target": {"type": ["number", "null"]},
        "max_rounds": {"type": "integer", "minimum": 1},
        "patience": {"type": "integer", "minimum": 1},
        "max_attempts_per_round": {"type": "integer", "minimum": 1}
      }
    },
    "budget": {
      "type": "object",
      "required": ["compute_hours", "annotation_items", "api_cost"],
      "additionalProperties": false,
      "properties": {
        "compute_hours": {"type": ["number", "null"]},
        "annotation_items": {"type": ["number", "null"]},
        "api_cost": {"type": ["number", "null"]}
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "train_command": {"type": "string", "minLength": 1},
        "onejev": {"type": "object"},
        "gpu_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    },
    "search_space": {"type": "object"},
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_configs": {"type": "integer", "minimum": 1},
        "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "probe_margin": {"type": "number", "minimum": 0},
        "accept_margin": {"type": "number", "minimum": 0},
        "guards": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
      }
    },
    "eval_use_limit": {"type": "integer", "minimum": 1},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reproduction_tolerance": {"type": "number"},
        "max_decision_mismatch_rate": {"type": "number"}
      }
    },
    "quality_checks": {"type": "object"},
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tune": {"type": "string", "enum": ["every_round", "on_demand"]},
        "max_returns": {"type": "integer", "minimum": 0},
        "max_continues": {"type": "integer", "minimum": 0},
        "checkin_minutes": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "max_checkins": {"type": "integer", "minimum": 0},
        "page_refresh_seconds": {"type": "number", "exclusiveMinimum": 0},
        "status_minutes": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "train_gate_failed": {"type": "string", "enum": ["code", "agent"]},
        "quality_gate_failed": {"type": "string", "enum": ["code", "agent"]},
        "handback_refused": {"type": "string", "enum": ["code", "agent"]},
        "handback_failed": {"type": "string", "enum": ["code", "agent"]}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "args": {"type": "array", "items": {"type": "string"}},
            "timeout_s": {"type": "number", "minimum": 1},
            "setting_sources": {"type": "array", "minItems": 1,
                                "items": {"type": "string", "enum": ["user", "project", "local"]}}
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {"type": "string",
                "enum": ["task_change", "over_budget", "use_testset", "refresh_sets", "plan", "delete"]}
    }
  }
}
