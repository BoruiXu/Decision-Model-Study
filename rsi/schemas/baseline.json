{
  "type": "object",
  "required": ["name", "trainset_id", "valset_id", "evalset_id", "testset_id", "spec", "spec_sha256", "config",
               "features", "metrics_val", "cost", "reused_from"],
  "properties": {
    "kind": {"type": "string", "enum": ["baseline"]},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "trainset_id": {"type": ["string", "null"], "minLength": 1},
    "valset_id": {"type": "string", "minLength": 1},
    "evalset_id": {"type": "string", "minLength": 1},
    "testset_id": {"type": ["string", "null"], "minLength": 1},
    "spec": {"type": "object"},
    "spec_sha256": {"type": "string", "minLength": 1},
    "config": {"type": "object"},
    "features": {"type": ["object", "null"]},
    "metrics_val": {"type": "object", "additionalProperties": {"type": "number"}},
    "cost": {
      "type": "object",
      "required": ["compute_hours"],
      "additionalProperties": false,
      "properties": {"compute_hours": {"type": "number", "minimum": 0}}
    },
    "model": {
      "type": "object",
      "required": ["location", "predict"],
      "additionalProperties": false,
      "properties": {
        "location": {"type": "string", "minLength": 1},
        "predict": {"type": "string", "minLength": 1}
      }
    },
    "reused_from": {"type": ["string", "null"], "minLength": 1}
  }
}
